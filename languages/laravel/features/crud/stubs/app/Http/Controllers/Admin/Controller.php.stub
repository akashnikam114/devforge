<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\__MODEL_CLASS__;
use App\Services\__SERVICE_CLASS__;
use Illuminate\Http\Request;
use DataTables;

class __CONTROLLER_CLASS__ extends Controller
{
    protected $service;

    public function __construct()
    {
        $this->service = new __SERVICE_CLASS__();
    }

    public function index(Request $request)
    {
        if ($request->ajax()) {
            $query = $this->service->fetchRecord($request->all());

            return DataTables::of($query)
__DATATABLE_COLUMNS__
                ->addColumn('action', function ($rec) {
                    return '<ul class="nk-tb-actions gx-1 my-n1">
                        <li class="me-n1">
                            <div class="dropdown">
                                <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <ul class="link-list-opt no-bdr">
                                        <li><a href="' . url('admin/__ROUTE_NAME__/edit') . '/' . $rec->id . '"><em class="icon ni ni-edit"></em><span>Edit __TITLE_SINGULAR__</span></a></li>
                                        <li><a href="javascript:void(0)" onclick="deleteRecord(' . $rec->id . ')"><em class="icon ni ni-trash"></em><span>Delete __TITLE_SINGULAR__</span></a></li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    </ul>';
                })
                ->rawColumns([__RAW_COLUMNS__])
                ->make(true);
        }

        return view('admin.__VIEW_DIRECTORY__.all');
    }

    public function create()
    {
        return view('admin.__VIEW_DIRECTORY__.add');
    }

    public function store(Request $request)
    {
        $validatedData = $request->validate([
__VALIDATION_RULES_CREATE__
        ]);

        $response = $this->service->store($validatedData);

        if ($response) {
            return redirect()->route('admin.__ROUTE_NAME__')->with('success', '__TITLE_SINGULAR__ added successfully.');
        }

        return back()->with('error', 'Something went wrong')->withInput();
    }

    public function edit($id)
    {
        $data = $this->service->fetch($id);

        if ($data) {
            return view('admin.__VIEW_DIRECTORY__.edit', compact('data'));
        }

        return redirect()->route('admin.__ROUTE_NAME__')->with('error', '__TITLE_SINGULAR__ not found.');
    }

    public function update(Request $request, $id)
    {
        $validatedData = $request->validate([
__VALIDATION_RULES_UPDATE__
        ]);

        $response = $this->service->update($id, $validatedData);

        if ($response) {
            return redirect()->route('admin.__ROUTE_NAME__')->with('success', '__TITLE_SINGULAR__ updated successfully.');
        }

        return back()->with('error', 'Something went wrong')->withInput();
    }

    public function destroy($id)
    {
        $record = __MODEL_CLASS__::find($id);

        if ($record) {
            $record->delete();
            return response()->json(['status' => 'success', 'message' => '__TITLE_SINGULAR__ deleted successfully.']);
        }

        return response()->json(['status' => 'error', 'message' => '__TITLE_SINGULAR__ not found.']);
    }

__STATUS_METHOD__
}
